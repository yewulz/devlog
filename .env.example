# Build variables, set in Cloudflare Pages > Settings > Variables and Secrets.
GITHUB_REPO=your-account/your-repository
GITHUB_BRANCH=main
SITE_URL=https://your-project.pages.dev
# Optional separate OAuth domain, otherwise the same as SITE_URL.
CMS_AUTH_ORIGIN=https://your-project.pages.dev

# Server-side variables. Never place these in public/ or site.json.
CMS_SITE_URL=https://your-project.pages.dev
GITHUB_CLIENT_ID=replace-with-your-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-a-secret-in-cloudflare
CMS_SESSION_SECRET=replace-with-at-least-32-random-characters
CMS_ALLOWED_USERS=your-github-login
# Set public for a public repository, private for a private repository.
CMS_REPO_VISIBILITY=public
